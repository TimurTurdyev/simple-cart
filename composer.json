{
    "name": "timurturdyev/laravel-cart",
    "description": "Shopping cart, wishlist and compare lists for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cart", "shopping-cart", "wishlist", "compare"],
    "authors": [
        {
            "name": "Timur Turdyev",
            "email": "borodatumur@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "TimurTurdyev\\Cart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimurTurdyev\\Cart\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "illuminate/database": "Required for the database storage driver"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TimurTurdyev\\Cart\\Providers\\CartServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
