{
    "name": "timurturdyev/simple-cart",
    "description": "A simple cart, wishlist and compare lists for Laravel - one core, safe concurrent writes, cart lifecycle",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cart", "shopping-cart", "wishlist", "compare"],
    "authors": [
        {
            "name": "Timur Turdyev",
            "email": "borodatumur@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "TimurTurdyev\\SimpleCart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimurTurdyev\\SimpleCart\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TimurTurdyev\\SimpleCart\\Providers\\CartServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
